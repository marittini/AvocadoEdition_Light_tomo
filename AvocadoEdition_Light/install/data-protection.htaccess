# Apache 2.4: all board/editor files go through the PHP permission gate.
Options -Indexes
<FilesMatch "\.(htaccess|htpasswd|php[0-9]*|phtml|html?|inc|cgi|pl|archive\.json)$">
    Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(file|editor)/(.+)$ ../bbs/archive_file.php?archive_kind=$1&archive_path=$2 [END,QSA]
</IfModule>

# Fail closed when rewriting is unavailable; resolve the host configuration before publishing.
<IfModule !mod_rewrite.c>
Require all denied
</IfModule>
